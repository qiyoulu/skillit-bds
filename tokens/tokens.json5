{
  // skillit brand design system — canonical token source (w3c design tokens)
  // single machine-readable source of truth. derived artifacts:
  //   - tokens.css        (CSS custom properties :root block)
  //   - tailwind-theme.js (tailwind theme extension)
  // no generator exists yet — keep tokens.css and tailwind-theme.js in sync manually.
  //
  // color usage scope (matches tokens/docs/color.md):
  //   accent/status colors mark text, functional buttons, selection/status indicators,
  //   and data. Semantic status icons use error/red, warning/yellow, success/green,
  //   and info/blue. Neutral utility indicators and completed progress use Iron. Controls
  //   and focus use Traffic Cone. Charts may use Cone, Tape, and other approved
  //   palette colors when labels/legends and contrast support the data story.
  //   Feedback uses Plaster panels and semantic icons, never decorative layout fills.
  //   structural borders are Iron; selection indicators have documented exceptions.
  //   focus outlines use Traffic Cone; verify adjacent contrast, especially on Canvas.
  //   action priority, not a color quota: one dominant CTA per section; functional
  //   Orange actions, selection, focus, and assigned chart roles may repeat.
  //   painter's tape: underlined = link, not underlined = info; approved chart fill allowed.
  //   accessible variants: opt-in darker steps of Cone, Hard Hat and Tape that clear 4.5:1 on Canvas
  //   and Plaster. use them only where a context requires AA and the brand color fails; the brand
  //   colors stay the default. NEVER use a variant as a default, theme or template color.
  //   default and accessible are SETS: a context uses one or the other, never a mix
  //   (accessible links hover to accessible.link-hover, not hover.link).
  //   Toolbox and Bottle Glass already pass and have no variant.
  base: {
    color: {
      bg: {
        $value: '#F7F1ED',
        $type: 'color',
        $description: 'Canvas — primary background. never pure white as global ground.',
        $extensions: {
          'org.skillit.role': 'background',
          'org.skillit.pantone': 'Paper',
        },
      },
      surface: {
        $value: '#FFFFFF',
        $type: 'color',
        $description: 'Plaster — elevated surfaces, cards, isolated form inputs.',
        $extensions: { 'org.skillit.role': 'surface', 'org.skillit.pantone': 'Paper' },
      },
      fg: {
        $value: '#232F36',
        $type: 'color',
        $description: 'Iron — foreground. all body text, headings, borders, structural elements.',
        $extensions: {
          'org.skillit.role': 'foreground',
          'org.skillit.pantone': '432 C',
        },
      },
      primary: {
        $value: '#EF6F1A',
        $type: 'color',
        $description: 'Traffic Cone — primary actions, checkbox/radio/chip selection, focus, and charts; functional repetition is permitted.',
        $extensions: {
          'org.skillit.role': 'accent',
          'org.skillit.pantone': '158 C',
        },
      },
      warning: {
        $value: '#FEB11C',
        $type: 'color',
        $description: 'Hard Hat — warning icons/feedback or approved chart role. Pair warning triangles with labels; verify light-surface contrast.',
        $extensions: { 'org.skillit.pantone': '1235 C' },
      },
      error: {
        $value: '#C8102E',
        $type: 'color',
        $description: 'Toolbox — error icons/text, destructive actions/feedback, or approved chart role.',
        $extensions: { 'org.skillit.pantone': '186 C' },
      },
      success: {
        $value: '#33663D',
        $type: 'color',
        $description: 'Bottle Glass — success icons/confirmation text or approved chart role; completed progress uses Iron, selection uses Traffic Cone.',
        $extensions: { 'org.skillit.pantone': '2427 C' },
      },
      link: {
        $value: '#007CA6',
        $type: 'color',
        $description: "Painter's Tape — info icons, links/information, and approved chart data.",
        $extensions: {
          'org.skillit.role': 'text-fill',
          'org.skillit.pantone': '3135 C',
        },
      },
      accessible: {
         'primary': { $value: '#B6500D', $type: 'color', $description: "Traffic Cone accessible variant — Opt-in only, never a default; the default is Traffic Cone. Opt in where AA is required and Traffic Cone fails. 4.5289:1 on Canvas, 5.0697:1 on Plaster. Text, icons and focus on light surfaces only; never fills, chart data or print." },
         'warning': { $value: '#986401', $type: 'color', $description: "Hard Hat accessible variant — Opt-in only, never a default; the default is Hard Hat. Opt in where AA is required and Hard Hat fails. 4.5113:1 on Canvas, 5.0500:1 on Plaster. Text, icons and focus on light surfaces only; never fills, chart data or print." },
         'link': { $value: '#0077A0', $type: 'color', $description: "Painter's Tape accessible variant — Opt-in only, never a default; the default is Painter's Tape. Opt in where AA is required and Painter's Tape fails. 4.5244:1 on Canvas, 5.0647:1 on Plaster. Text, icons and focus on light surfaces only; never fills, chart data or print." },
         'link-hover': { $value: 'color-mix(in oklab, var(--color-link-accessible), black 10%)', $type: 'color', $description: "Painter's Tape accessible hover — accessible set only; 5.6626:1 on Canvas, 6.3388:1 on Plaster. Never pair with default link tokens." },
      },
      hover: {
         'bg': { $value: 'color-mix(in oklab, var(--color-background), black 10%)',
            $type: 'color',
            $description: 'Canvas hover — color-mix(in oklab, base, black 10%)' },
         'surface': { $value: 'color-mix(in oklab, var(--color-surface), black 10%)', $type: 'color', $description: 'Plaster hover — color-mix(in oklab, base, black 10%)' },
         'fg': { $value: 'color-mix(in oklab, var(--color-foreground), black 10%)', $type: 'color', $description: 'Iron hover — color-mix(in oklab, base, black 10%)' },
         'primary': { $value: 'color-mix(in oklab, var(--color-primary), black 10%)', $type: 'color', $description: 'Traffic Cone hover — color-mix(in oklab, base, black 10%)' },
         'warning': { $value: 'color-mix(in oklab, var(--color-warning), black 10%)', $type: 'color', $description: 'Hard Hat hover — color-mix(in oklab, base, black 10%)' },
         'error': { $value: 'color-mix(in oklab, var(--color-error), black 10%)', $type: 'color', $description: 'Toolbox hover — color-mix(in oklab, base, black 10%)' },
         'success': { $value: 'color-mix(in oklab, var(--color-success), black 10%)', $type: 'color', $description: 'Bottle Glass hover — color-mix(in oklab, base, black 10%)' },
         'link': { $value: 'color-mix(in oklab, var(--color-link), black 10%)', $type: 'color', $description: "Painter's Tape hover — color-mix(in oklab, base, black 10%)" },
      },
    },
    spacing: {
      '1': { $value: '0.25rem', $type: 'dimension', $description: '4px — micro gaps, icon-to-label' },
      '1.5': { $value: '0.375rem', $type: 'dimension', $description: '6px — small-viewport text list gaps' },
      '2': { $value: '0.5rem', $type: 'dimension', $description: '8px — compact spacing, badge padding' },
      '3': { $value: '0.75rem', $type: 'dimension', $description: '12px — small gaps' },
      '4': { $value: '1rem', $type: 'dimension', $description: '16px — default spacing unit, paragraph gap' },
      '5': { $value: '1.25rem', $type: 'dimension', $description: '20px — medium, between form groups' },
      '6': { $value: '1.5rem', $type: 'dimension', $description: '24px — standard section padding' },
      '8': { $value: '2rem', $type: 'dimension', $description: '32px — between unrelated elements, nav to content' },
      '10': { $value: '2.5rem', $type: 'dimension', $description: '40px — large section gaps' },
      '12': { $value: '3rem', $type: 'dimension', $description: '48px — section breaks' },
      '16': { $value: '4rem', $type: 'dimension', $description: '64px — major section separators' },
      '20': { $value: '5rem', $type: 'dimension', $description: '80px — hero padding, full-bleed section margins' },
      '24': { $value: '6rem', $type: 'dimension', $description: '96px — maximum section vertical padding' },
      '128': { $value: 'clamp(2rem, calc(12.5vw - 2rem), 8rem)', $type: 'dimension', $description: 'page top/bottom padding and section gaps — 32px floor, 64px at 768, 128px at 1280 (twice the gutter at every width up to 768)' },
      'gutter': { $value: 'clamp(1rem, calc(6.25vw - 1rem), 2rem)', $type: 'dimension', $description: 'one value for the page side margin and the column gap — 16px to 512px, ramps to 32px at 768px, 32px above; shared by header, body, footer and grids. Half of the space-128 value up to 768px' },
      'page': { $value: 'clamp(2rem, calc(12.5vw - 2rem), 8rem)', $type: 'dimension', $description: 'alias for spacing-128 — page top/bottom padding and section gaps, named for its role' },
      'space-0.25x': { $value: '0.25rem', $type: 'dimension', $description: 'DEPRECATED — alias for spacing-1; use space-1' },
      'space-0.5x': { $value: '0.5rem', $type: 'dimension', $description: 'DEPRECATED — alias for spacing-2; use space-2' },
      'space-1x': { $value: '1rem', $type: 'dimension', $description: 'DEPRECATED — alias for spacing-4; use space-4' },
      'space-1.5x': { $value: '1.5rem', $type: 'dimension', $description: 'DEPRECATED — alias for spacing-6; use space-6' },
      'space-2x': { $value: '2rem', $type: 'dimension', $description: 'DEPRECATED — alias for spacing-8; use space-8' },
      'space-3x': { $value: '3rem', $type: 'dimension', $description: 'DEPRECATED — alias for spacing-12; use space-12' },
      'space-4x': { $value: '4rem', $type: 'dimension', $description: 'DEPRECATED — alias for spacing-16; use space-16' },
      'space-6x': { $value: '6rem', $type: 'dimension', $description: 'DEPRECATED — alias for spacing-24; use space-24' },
      'space-8x': { $value: '8rem', $type: 'dimension', $description: 'DEPRECATED — fixed 128px, no numeric equivalent and no consumers; use space-page for the fluid page padding' },
    },
    typography: {
      family: {
        primary: { $value: "'Work Sans', sans-serif", $type: 'fontFamily', $description: 'headings, subheadings, body copy, bylines, buttons, labels' },
        mono: { $value: "'JetBrains Mono', monospace", $type: 'fontFamily', $description: 'metadata, IDs, data, code blocks, timestamps, captions, footnotes, references — intentional same-size pairing with Work Sans; x-height is slightly taller' },
      },
      text: {
        '8x': {
          $value: { fontFamily: '{base.typography.family.primary}', fontSize: '8rem', fontWeight: 700, lineHeight: 0.8, letterSpacing: '-0.06em' },
          $type: 'typography',
          $description: 'Text-8x — hero headlines. fluid mobile: clamp(6rem, 5.17rem + 3.54vw, 8rem). bolded: 900.',
          $extensions: { 'org.skillit.print': '96pt', 'org.skillit.sm': 'clamp(6rem, 5.17rem + 3.54vw, 8rem)' },
        },
        '6x': {
          $value: { fontFamily: '{base.typography.family.primary}', fontSize: '6rem', fontWeight: 650, lineHeight: 0.9, letterSpacing: '-0.05em' },
          $type: 'typography',
          $description: 'Text-6x — large display. fluid mobile: clamp(4.5rem, 3.88rem + 2.65vw, 6rem). bolded: 850. Mono uses the same tier size.',
          $extensions: { 'org.skillit.print': '72pt', 'org.skillit.sm': 'clamp(4.5rem, 3.88rem + 2.65vw, 6rem)' },
        },
        '4x': {
          $value: { fontFamily: '{base.typography.family.primary}', fontSize: '4rem', fontWeight: 600, lineHeight: 1.0, letterSpacing: '-0.04em' },
          $type: 'typography',
          $description: 'Text-4x — medium display. fluid mobile: clamp(3rem, 2.59rem + 1.77vw, 4rem). bolded: 800. Mono uses the same tier size.',
          $extensions: { 'org.skillit.print': '48pt', 'org.skillit.sm': 'clamp(3rem, 2.59rem + 1.77vw, 4rem)' },
        },
        '3x': {
          $value: { fontFamily: '{base.typography.family.primary}', fontSize: '3rem', fontWeight: 550, lineHeight: 1.1, letterSpacing: '-0.03em' },
          $type: 'typography',
          $description: 'Text-3x — small display. fluid mobile: clamp(2.25rem, 1.94rem + 1.33vw, 3rem). bolded: 750. Mono uses the same tier size.',
          $extensions: { 'org.skillit.print': '36pt', 'org.skillit.sm': 'clamp(2.25rem, 1.94rem + 1.33vw, 3rem)' },
        },
        '2x': {
          $value: { fontFamily: '{base.typography.family.primary}', fontSize: '2rem', fontWeight: 500, lineHeight: 1.2, letterSpacing: '-0.02em' },
          $type: 'typography',
          $description: 'Text-2x — large heading. fluid mobile: clamp(1.5rem, 1.29rem + 0.88vw, 2rem). bolded: 700. Mono uses the same tier size.',
          $extensions: { 'org.skillit.print': '24pt', 'org.skillit.sm': 'clamp(1.5rem, 1.29rem + 0.88vw, 2rem)' },
        },
        '1.5x': {
          $value: { fontFamily: '{base.typography.family.primary}', fontSize: '1.5rem', fontWeight: 450, lineHeight: 1.3, letterSpacing: '-0.01em' },
          $type: 'typography',
          $description: 'Text-1.5x — small heading. fluid mobile: clamp(1.125rem, 0.97rem + 0.66vw, 1.5rem). bolded: 650. Mono uses the same tier size.',
          $extensions: { 'org.skillit.print': '18pt', 'org.skillit.sm': 'clamp(1.125rem, 0.97rem + 0.66vw, 1.5rem)' },
        },
        '1x': {
          $value: { fontFamily: '{base.typography.family.primary}', fontSize: '1rem', fontWeight: 400, lineHeight: 1.4, letterSpacing: '0em' },
          $type: 'typography',
          $description: 'Text-1x — all running copy, default UI body. 16px held on mobile. bolded: 600.',
          $extensions: { 'org.skillit.print': '12pt', 'org.skillit.sm': '1rem' },
        },
        '0.75x': { $value: { fontFamily: '{base.typography.family.primary}', fontSize: '0.75rem', fontWeight: 550, lineHeight: 1.4, letterSpacing: '0.04em' }, $type: 'typography', $description: 'Text-0.75x — 12px. labels, tags, badges, captions. minimum size. for machine metadata use var(--font-mono) at the same size.' },
      },
      padding: {
        '0.75x': { $value: '0.375rem 0.75rem', $type: 'dimension', $description: '6px / 12px. pairs with Text-0.75x (12px); follows the half-size/full-size padding ratio.' },
        '1x':    { $value: '0.5rem 1rem',      $type: 'dimension', $description: 'default — 8px / 16px. pairs with Text-1x (16px). 0.5em / 1em tactile ratio at 16px.' },
        '1.5x':  { $value: '0.75rem 1.5rem',  $type: 'dimension', $description: 'medium — 12px / 24px. pairs with Text-1.5x (24px). 0.5em / 1em tactile ratio at 24px.' },
        '2x':    { $value: '1rem 2rem',        $type: 'dimension', $description: 'large — 16px / 32px. pairs with Text-2x (32px). 0.5em / 1em tactile ratio at 32px.' },
      },
      weight: {
        regular: { $value: 400, $type: 'fontWeight' },
        medium: { $value: 500, $type: 'fontWeight' },
        semibold: { $value: 600, $type: 'fontWeight' },
        bold: { $value: 700, $type: 'fontWeight' },
        extrabold: { $value: 800, $type: 'fontWeight' },
        black: { $value: 900, $type: 'fontWeight' },
        // optical balancing for dark backgrounds — subtract ~25 units
        'regular-dark': { $value: 375, $type: 'fontWeight', $description: '375 — light text on dark, halation compensation' },
        'medium-dark': { $value: 475, $type: 'fontWeight' },
        'semibold-dark': { $value: 575, $type: 'fontWeight' },
        'bold-dark': { $value: 675, $type: 'fontWeight' },
        'extrabold-dark': { $value: 775, $type: 'fontWeight' },
        'black-dark': { $value: 875, $type: 'fontWeight' },
      },
    },
    radius: {
      sharp: { $value: '16px', $type: 'dimension', $description: 'static containers, photos, cards — 16px corners; inner glyph geometry uses its documented silhouette' },
      soft: { $value: '16px', $type: 'dimension', $description: 'alias of sharp. static containers, photos, cards — 16px corners; inner glyph geometry uses its documented silhouette' },
      pill: { $value: '9999px', $type: 'dimension', $description: 'button-like actions and interactive badges — 9999px; status/selection indicator shape alone does not imply action.' },
    },
    layout: {
      'max-width-content': { $value: '1200px', $type: 'dimension', $description: 'website / marketing grid max content width — centered; 32px side padding from 768px, so the cap is reached at 1264px' },
      'column-min-width': { $value: '326px', $type: 'dimension', $description: 'single grid column minimum width — below this the column content breaks' },
      'max-width-app': { $value: '1200px', $type: 'dimension', $description: 'app (worker-facing) max width — centered; 32px side padding from 768px, so the cap is reached at 1264px' },
      'max-width-text': { $value: '70ch', $type: 'dimension', $description: 'body text column max width — never exceed' },
      'touch-target-min': { $value: '40px', $type: 'dimension', $description: 'minimum touch target — app and mobile web' },
      'nav-height': { $value: '64px', $type: 'dimension', $description: 'primary nav bar height' },
      'logo-mark-min': { $value: '21px', $type: 'dimension', $description: 'mark minimum size — below this the negative space closes up' },
      'logo-height': { $value: '32px', $type: 'dimension', $description: 'standard header logo height — lockup and mark use the same height' },
      'wordmark-min': { $value: '16px', $type: 'dimension', $description: 'wordmark minimum size' },
    },
    breakpoint: {
      sm: { $value: '480px', $type: 'dimension', $description: 'large mobile' },
      md: { $value: '768px', $type: 'dimension', $description: 'tablet — side padding 32px, two-column grid' },
      lg: { $value: '1024px', $type: 'dimension', $description: '12-column grid; navigation still collapses to menu button and mark below xl' },
      xl: { $value: '1280px', $type: 'dimension', $description: 'full navigation bar and lockup; page top/bottom padding reaches 128px' },
    },
    motion: {
      duration: {
        fast: { $value: '150ms', $type: 'time', $description: 'Color swap, opacity toggle' },
        medium: { $value: '300ms', $type: 'time', $description: 'Expand/collapse, slide' },
        slow: { $value: '600ms', $type: 'time', $description: 'Modal open/close' },
      },
      easing: {
        out: { $value: 'cubic-bezier(0.25, 0.46, 0.45, 0.94)', $type: 'easing', $description: 'Enter (fast start, gentle land)' },
        in: { $value: 'cubic-bezier(0.55, 0.085, 0.68, 0.53)', $type: 'easing', $description: 'Exit (slow start, quick leave)' },
      },
    },
    z: {
      header: { $value: '10', $type: 'number', $description: 'Sticky header, nav' },
      dropdown: { $value: '20', $type: 'number', $description: 'Dropdown menus' },
      overlay: { $value: '30', $type: 'number', $description: 'Modal backdrop' },
      modal: { $value: '40', $type: 'number', $description: 'Modal dialog' },
      toast: { $value: '50', $type: 'number', $description: 'Toast notifications' },
    },
  },
}
