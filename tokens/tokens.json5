{
  // skillit brand design system — canonical token source (w3c design tokens)
  // single machine-readable source of truth. derived artifacts:
  //   - tokens.css        (CSS custom properties :root block)
  //   - tailwind-theme.js (tailwind theme extension)
  // no generator exists yet — keep tokens.css and tailwind-theme.js in sync manually.
  //
  // color usage scope (matches tokens/color.md):
  //   colors appear ONLY as (1) text fill on canvas/plaster/iron, (2) button bg fill,
  //   (3) icons incl. status badges. never layout backgrounds, decorative fills,
  //   borders, or shadows. borders and focus rings are always iron.
  //   painter's tape (link): underlined = link, not underlined = info. never a fill.
  base: {
    color: {
      bg: {
        $value: '#FAF7F3',
        $type: 'color',
        $description: 'Canvas — primary background. never pure white as global ground.',
        $extensions: {
          'org.skillit.role': 'background',
          'org.skillit.pantone': 'Paper',
        },
      },
      surface: {
        $value: '#FFFFFF',
        $type: 'color',
        $description: 'Plaster — elevated surfaces, cards, isolated form inputs.',
        $extensions: { 'org.skillit.role': 'surface' },
      },
      fg: {
        $value: '#232F36',
        $type: 'color',
        $description: 'Iron — foreground. all body text, headings, borders, structural elements.',
        $extensions: {
          'org.skillit.role': 'foreground',
          'org.skillit.pantone': '432 C',
        },
      },
      primary: {
        $value: '#EF6F1A',
        $type: 'color',
        $description: 'Traffic Cone — primary action. one accent per section.',
        $extensions: {
          'org.skillit.role': 'accent',
          'org.skillit.pantone': '158 C',
        },
      },
      warning: {
        $value: '#FEB11C',
        $type: 'color',
        $description: 'Hard Hat — non-fatal alerts, warnings. always pair with shape + label.',
        $extensions: { 'org.skillit.pantone': '1235 C' },
      },
      error: {
        $value: '#C8102E',
        $type: 'color',
        $description: 'Toolbox — fatal errors, destructive actions.',
        $extensions: { 'org.skillit.pantone': '186 C' },
      },
      success: {
        $value: '#33663D',
        $type: 'color',
        $description: 'Bottle Glass — confirmations, success states. Canvas text only.',
        $extensions: { 'org.skillit.pantone': '2427 C' },
      },
      link: {
        $value: '#007CA6',
        $type: 'color',
        $description: "Painter's Tape — link. never a fill.",
        $extensions: {
          'org.skillit.role': 'text-fill',
          'org.skillit.pantone': '3135 C',
        },
      },
      hover: {
         'bg': { $value: '#EAE5DF', $type: 'color', $description: 'Canvas hover — × EFEDE9' },
        'surface': { $value: '#EFEDE9', $type: 'color', $description: 'Plaster hover — × EFEDE9' },
        'fg': { $value: '#212C31', $type: 'color', $description: 'Iron hover — × EFEDE9' },
         'primary': { $value: '#E06818', $type: 'color', $description: 'Traffic Cone hover — × EFEDE9' },
         'warning': { $value: '#EEA41A', $type: 'color', $description: 'Hard Hat hover — × EFEDE9' },
         'error': { $value: '#BC0E2A', $type: 'color', $description: 'Toolbox hover — × EFEDE9' },
        'success': { $value: '#305F38', $type: 'color', $description: 'Bottle Glass hover — × EFEDE9' },
        'link': { $value: '#007398', $type: 'color', $description: "Painter's Tape hover — × EFEDE9" },
      },
    },
    spacing: {
      '1': { $value: '0.25rem', $type: 'dimension', $description: '4px — micro gaps, icon-to-label' },
      '1.5': { $value: '0.375rem', $type: 'dimension', $description: '6px — small-viewport text list gaps' },
      '2': { $value: '0.5rem', $type: 'dimension', $description: '8px — compact spacing, badge padding' },
      '3': { $value: '0.75rem', $type: 'dimension', $description: '12px — small gaps, input field internal padding' },
      '4': { $value: '1rem', $type: 'dimension', $description: '16px — default spacing unit, paragraph gap' },
      '5': { $value: '1.25rem', $type: 'dimension', $description: '20px — medium, between form groups' },
      '6': { $value: '1.5rem', $type: 'dimension', $description: '24px — standard section padding' },
      '8': { $value: '2rem', $type: 'dimension', $description: '32px — between unrelated elements, nav to content' },
      '10': { $value: '2.5rem', $type: 'dimension', $description: '40px — large section gaps' },
      '12': { $value: '3rem', $type: 'dimension', $description: '48px — section breaks' },
      '16': { $value: '4rem', $type: 'dimension', $description: '64px — major section separators' },
      '20': { $value: '5rem', $type: 'dimension', $description: '80px — hero padding, full-bleed section margins' },
      '24': { $value: '6rem', $type: 'dimension', $description: '96px — maximum section vertical padding' },
      '128': { $value: 'clamp(48px, 10vw, 128px)', $type: 'dimension', $description: 'desktop section gaps, page margins' },
      '256': { $value: 'clamp(96px, 18vw, 256px)', $type: 'dimension', $description: 'massive editorial breaks' },
    },
    typography: {
      family: {
        primary: { $value: "'Work Sans', sans-serif", $type: 'fontFamily', $description: 'the only typeface — UI, headings, body, marketing, print' },
        mono: { $value: "'IBM Plex Mono', 'JetBrains Mono', monospace", $type: 'fontFamily', $description: 'metadata, IDs, data — scale to 0.9em inline' },
      },
      text: {
        '8x': {
          $value: { fontFamily: '{base.typography.family.primary}', fontSize: '8rem', fontWeight: 700, lineHeight: 0.8, letterSpacing: '-0.06em' },
          $type: 'typography',
          $description: 'Text-8x — hero headlines. fluid mobile: clamp(6rem, 5.17rem + 3.54vw, 8rem). bolded: 900.',
          $extensions: { 'org.skillit.print': '96pt', 'org.skillit.sm': 'clamp(6rem, 5.17rem + 3.54vw, 8rem)' },
        },
        '6x': {
          $value: { fontFamily: '{base.typography.family.primary}', fontSize: '6rem', fontWeight: 650, lineHeight: 0.9, letterSpacing: '-0.05em' },
          $type: 'typography',
          $description: 'Text-6x — large display. fluid mobile: clamp(4.5rem, 3.88rem + 2.65vw, 6rem). bolded: 850. mono: 5.175rem.',
          $extensions: { 'org.skillit.print': '72pt', 'org.skillit.sm': 'clamp(4.5rem, 3.88rem + 2.65vw, 6rem)' },
        },
        '4x': {
          $value: { fontFamily: '{base.typography.family.primary}', fontSize: '4rem', fontWeight: 600, lineHeight: 1.0, letterSpacing: '-0.04em' },
          $type: 'typography',
          $description: 'Text-4x — medium display. fluid mobile: clamp(3rem, 2.59rem + 1.77vw, 4rem). bolded: 800. mono: 3.6rem.',
          $extensions: { 'org.skillit.print': '48pt', 'org.skillit.sm': 'clamp(3rem, 2.59rem + 1.77vw, 4rem)' },
        },
        '3x': {
          $value: { fontFamily: '{base.typography.family.primary}', fontSize: '3rem', fontWeight: 550, lineHeight: 1.1, letterSpacing: '-0.03em' },
          $type: 'typography',
          $description: 'Text-3x — small display. fluid mobile: clamp(2.25rem, 1.94rem + 1.33vw, 3rem). bolded: 700. mono: 2.7rem.',
          $extensions: { 'org.skillit.print': '36pt', 'org.skillit.sm': 'clamp(2.25rem, 1.94rem + 1.33vw, 3rem)' },
        },
        '2x': {
          $value: { fontFamily: '{base.typography.family.primary}', fontSize: '2rem', fontWeight: 500, lineHeight: 1.2, letterSpacing: '-0.02em' },
          $type: 'typography',
          $description: 'Text-2x — large heading. fluid mobile: clamp(1.5rem, 1.29rem + 0.88vw, 2rem). bolded: 700. mono: 1.8rem.',
          $extensions: { 'org.skillit.print': '24pt', 'org.skillit.sm': 'clamp(1.5rem, 1.29rem + 0.88vw, 2rem)' },
        },
        '1.5x': {
          $value: { fontFamily: '{base.typography.family.primary}', fontSize: '1.5rem', fontWeight: 450, lineHeight: 1.3, letterSpacing: '-0.01em' },
          $type: 'typography',
          $description: 'Text-1.5x — small heading. fluid mobile: clamp(1.125rem, 0.97rem + 0.66vw, 1.5rem). bolded: 600. mono: 1.35rem.',
          $extensions: { 'org.skillit.print': '18pt', 'org.skillit.sm': 'clamp(1.125rem, 0.97rem + 0.66vw, 1.5rem)' },
        },
        '1x': {
          $value: { fontFamily: '{base.typography.family.primary}', fontSize: '1rem', fontWeight: 400, lineHeight: 1.4, letterSpacing: '0em' },
          $type: 'typography',
          $description: 'Text-1x — all running copy. mobile: 1rem (16px, held — see typography.md). bolded: 600. mono: 0.875rem.',
          $extensions: { 'org.skillit.print': '12pt', 'org.skillit.sm': '1rem' },
        },
        'mono': {
          '8x': { $value: { fontFamily: '{base.typography.family.mono}', fontSize: '7.1875rem', fontWeight: 700, lineHeight: 0.8, letterSpacing: '-0.06em' }, $type: 'typography', $description: 'Text-8x mono — hero metadata' },
          '6x': { $value: { fontFamily: '{base.typography.family.mono}', fontSize: '5.375rem', fontWeight: 650, lineHeight: 0.9, letterSpacing: '-0.05em' }, $type: 'typography', $description: 'Text-6x mono — large stats' },
          '4x': { $value: { fontFamily: '{base.typography.family.mono}', fontSize: '3.625rem', fontWeight: 600, lineHeight: 1.0, letterSpacing: '-0.04em' }, $type: 'typography', $description: 'Text-4x mono — section stats' },
          '3x': { $value: { fontFamily: '{base.typography.family.mono}', fontSize: '2.6875rem', fontWeight: 550, lineHeight: 1.1, letterSpacing: '-0.03em' }, $type: 'typography', $description: 'Text-3x mono — subsection stats' },
          '2x': { $value: { fontFamily: '{base.typography.family.mono}', fontSize: '1.8125rem', fontWeight: 500, lineHeight: 1.2, letterSpacing: '-0.02em' }, $type: 'typography', $description: 'Text-2x mono — subhead stats' },
          '1.5x': { $value: { fontFamily: '{base.typography.family.mono}', fontSize: '1.375rem', fontWeight: 450, lineHeight: 1.3, letterSpacing: '-0.01em' }, $type: 'typography', $description: 'Text-1.5x mono — small data' },
          '1x': { $value: { fontFamily: '{base.typography.family.mono}', fontSize: '0.875rem', fontWeight: 400, lineHeight: 1.4, letterSpacing: '0em' }, $type: 'typography', $description: 'Text-1x mono — timestamps, metadata' },
        },
        'ui': { $value: { fontSize: '1rem', fontWeight: 400, lineHeight: 1.6, letterSpacing: '0' }, $type: 'typography', $description: 'default UI body' },
        label: { $value: { fontSize: '0.75rem', fontWeight: 500, lineHeight: 1.4, letterSpacing: '0.04em' }, $type: 'typography', $description: 'labels, tags, badges — sentence-case, minimum size' },
      },
      weight: {
        regular: { $value: 400, $type: 'fontWeight' },
        medium: { $value: 500, $type: 'fontWeight' },
        semibold: { $value: 600, $type: 'fontWeight' },
        bold: { $value: 700, $type: 'fontWeight' },
        extrabold: { $value: 800, $type: 'fontWeight' },
        black: { $value: 900, $type: 'fontWeight' },
        // optical balancing for dark backgrounds — subtract ~25 units
        'regular-dark': { $value: 375, $type: 'fontWeight', $description: '375 — light text on dark, halation compensation' },
        'medium-dark': { $value: 475, $type: 'fontWeight' },
        'semibold-dark': { $value: 575, $type: 'fontWeight' },
        'bold-dark': { $value: 675, $type: 'fontWeight' },
        'extrabold-dark': { $value: 775, $type: 'fontWeight' },
        'black-dark': { $value: 875, $type: 'fontWeight' },
      },
    },
    radius: {
      sharp: { $value: '16px', $type: 'dimension', $description: 'structural containers, photos, cards, icons — universal 16px corners' },
      pill: { $value: '9999px', $type: 'dimension', $description: 'actionable touchpoints — buttons, badges. 100vmax or 9999px.' },
    },
    layout: {
      'max-width-content': { $value: '1200px', $type: 'dimension', $description: 'website / marketing max content width' },
      'max-width-app': { $value: '480px', $type: 'dimension', $description: 'app (worker-facing) max width, mobile-first' },
      'max-width-text': { $value: '70ch', $type: 'dimension', $description: 'body text column max width — never exceed' },
      'touch-target-min': { $value: '44px', $type: 'dimension', $description: 'minimum touch target, Apple HIG / WCAG 2.5.5' },
      'nav-height': { $value: '64px', $type: 'dimension', $description: 'primary nav bar height' },
      'logo-mark-min': { $value: '21px', $type: 'dimension', $description: 'mark minimum size — below this the negative space closes up' },
      'wordmark-min': { $value: '16px', $type: 'dimension', $description: 'wordmark minimum size' },
    },
    breakpoint: {
      sm: { $value: '480px', $type: 'dimension', $description: 'large mobile' },
      md: { $value: '768px', $type: 'dimension', $description: 'tablet — lockup collapses to mark' },
      lg: { $value: '1024px', $type: 'dimension', $description: 'desktop — grid collapses to single column below this' },
      xl: { $value: '1280px', $type: 'dimension', $description: 'wide desktop' },
    },
  },
}
